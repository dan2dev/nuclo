{
  "name": "001-counter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"deno run server \"",
    "dev:vite": "vite",
    "dev:server": "deno run --allow-net --allow-read --allow-env --allow-write src/server.ts",
    "build": "tsc && vite build",
    "prepreview": "tsc && vite build",
    "preview": "vite preview",
    "server": "deno run src/server.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "happy-dom": "^20.11.6",
    "hono": "^4.13.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.5",
    "nuclo": "workspace:*",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "vite": "^8.2.2"
  }
}
