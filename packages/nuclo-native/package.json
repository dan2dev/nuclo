{
	"name": "nuclo-native",
	"private": true,
	"version": "0.0.0",
	"description": "POC: nuclo apps rendered with real native widgets and native navigation on Android, iOS, macOS, Windows and Linux, a GPUI host for all five, and the web.",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"web": "./src/web.ts",
			"default": "./src/index.ts"
		},
		"./router": {
			"web": "./src/router-web.ts",
			"default": "./src/router.ts"
		},
		"./device": {
			"web": "./src/device-web.ts",
			"default": "./src/device.ts"
		},
		"./check": {
			"web": "./src/check-web.ts",
			"default": "./src/check.ts"
		}
	},
	"scripts": {
		"build": "bun scripts/run.ts build",
		"build:web": "bun scripts/build-web.ts",
		"ios": "bun scripts/run.ts ios",
		"ios-gpui": "bun scripts/run.ts ios-gpui",
		"android": "bun scripts/run.ts android",
		"android-gpui": "bun scripts/run.ts android-gpui",
		"macos": "bun scripts/run.ts macos",
		"macos-gpui": "bun scripts/run.ts macos-gpui",
		"linux": "bun scripts/run.ts linux",
		"linux-gpui": "bun scripts/run.ts linux-gpui",
		"windows": "bun scripts/run.ts windows",
		"windows-gpui": "bun scripts/run.ts windows-gpui",
		"web": "bun scripts/run.ts web",
		"test": "bun test --isolate",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"nuclo": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"typescript": "^7.0.2"
	}
}
