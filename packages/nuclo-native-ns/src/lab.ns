// ---- collapsing header -----------------------------------------------------------------------------------------

let scrollTop = 0.0

// The hero scrolls with the list (a scroll moves it, not a relayout); a bar over it fades in as it goes.
// Everything that follows the scroll is a transform or an opacity: no layout on a scroll frame.
const HERO_H = 260.0
const BAR_H = 56.0
/** 0 while the hero shows, 1 once it is under the bar. */
fn collapsed() => clamp((scrollTop - (HERO_H - BAR_H - 60.0)) / 60.0, 0.0, 1.0)

const heroBox = css({ height: HERO_H, overflow: "hidden" })
fn heroImg() => css({
  position: "absolute", top: 0, left: 0, right: 0, height: HERO_H,
  // Parallax: the photo moves at half the scroll; pulled down, it grows.
  translateY: scrollTop > 0.0 ? scrollTop * 0.5 : scrollTop, scale: 1.0 + clamp(0.0 - scrollTop, 0.0, 200.0) / HERO_H,
})
const heroShade = css({ position: "absolute", left: 0, right: 0, bottom: 0, height: 120, backgroundColor: "rgba(0,0,0,0.28)" })
fn bigTitle() => css({
  position: "absolute", left: space.lg, right: space.lg, bottom: space.lg, color: "#ffffff", fontSize: 32, fontWeight: "bold",
  opacity: 1.0 - clamp((scrollTop - 40.0) / 100.0, 0.0, 1.0),
})
const bar = css({ position: "absolute", top: 0, left: 0, right: 0, height: BAR_H, flexDirection: "row", alignItems: "center", gap: space.xs, px: space.xs })
fn barFill() => css({
  position: "absolute", top: 0, left: 0, right: 0, bottom: 0, backgroundColor: t().surface, opacity: collapsed(),
  borderBottomWidth: 1, borderColor: t().line,
})
fn barTitle() => css({ fontSize: font.headline, fontWeight: "semibold", color: t().text, opacity: collapsed(), translateY: (1.0 - collapsed()) * 8.0 })
// The back button: a dark round behind it over the photo, gone once the bar is opaque.
const backBox = css({ width: 44, height: 44, alignItems: "center", justifyContent: "center", pressed: { opacity: 0.5 } })
fn backRound() => css({ position: "absolute", top: 4, left: 4, width: 36, height: 36, borderRadius: 18, backgroundColor: "rgba(0,0,0,0.35)", opacity: 1.0 - collapsed() })

const collapseScroll = css({ flex: 1, overflow: "scroll" })

export fn collapsingScreen(): View {
  scrollTop = 0.0
  return div(fixedPage,
    div(collapseScroll, { onScroll: (e: Scroll) => { scrollTop = e.top; update() } },
      div(heroBox,
        img(() => heroImg(), { src: photoUrlWH(29, 720, 446) }),
        div(heroShade),
        p(() => bigTitle(), "Kyoto in autumn"),
      ),
      list(() => posts, (x, i) => div(css({ flexDirection: "row", gap: space.md, padding: space.lg, borderBottomWidth: 1, borderColor: t().line }),
        img(css({ width: 64, height: 64, borderRadius: radius.sm }), { src: photoUrl(x.photo, 64) }),
        div(grow, p(strongText, x.place), p(footnote, x.caption)),
      )),
    ),
    // After the list: drawn over it on every platform.
    div(bar,
      div(() => barFill()),
      div(backBox, { label: "Back", onClick: () => back() },
        div(() => backRound()),
        liveIcon("arrowBack", () => collapsed() > 0.5 ? t().text : "#ffffff", () => false, 24),
      ),
      p(() => barTitle(), "Kyoto in autumn"),
    ),
  )
}

// ---- forms ------------------------------------------------------------------------------------------------------

let fName = ""
let fEmail = ""
let fPass = ""
let fAbout = ""
let fTerms = false
let fNews = true
let fPlan = 1
let fSize = 2
let submitted = false

const formBox = css({ gap: space.lg, padding: space.lg })
const fieldWrap = css({ gap: space.xs })
const fieldLabel = themed(() => css({ fontSize: font.footnote, fontWeight: "semibold", color: t().muted }))
fn fieldStyle(bad: bool) => css({ height: 48, px: space.md, borderRadius: radius.md, backgroundColor: t().surface2, color: t().text, fontSize: font.body, borderWidth: 2, borderColor: bad ? t().danger : t().surface2 })
const error = themed(() => css({ fontSize: font.caption, color: t().danger }))
const areaStyle = themed(() => css({ minHeight: 90, padding: space.md, borderRadius: radius.md, backgroundColor: t().surface2, color: t().text, fontSize: font.body }))

fn validEmail() => fEmail.includes("@") && fEmail.includes(".")
fn nameBad() => submitted && fName.trim() == ""
fn emailBad() => submitted && !validEmail()
fn passBad() => submitted && fPass.length < 8

fn submitForm() {
  submitted = true
  if (fName.trim() != "" && validEmail() && fPass.length >= 8 && fTerms) {
    haptic("success")
    alert("Welcome, " + fName.trim() + "!", `Plan: ${["Free", "Plus", "Pro"][fPlan]}. Check ${fEmail} to confirm.`, [act("OK", "", () => {})])
  } else {
    haptic("medium")
    toast(fName.trim() == "" || !validEmail() || fPass.length < 8 ? "Check the fields in red" : "Accept the terms to continue")
  }
  update()
}

const switchRowStyle = css({ flexDirection: "row", alignItems: "center", gap: space.md, minHeight: 44 })
const switchLabel = themed(() => css({ flex: 1, fontSize: font.body, color: t().text }))

const switchOnly = css({ pointerEvents: "none" })

/** A label and its switch: a tap on the label flips it too, as in the platform's settings. */
fn switchRow(label: string, on: () => bool, set: (bool) => void): View =>
  div(switchRowStyle, { onClick: () => { set(!on()); haptic("light"); update() } },
    p(switchLabel, label),
    // The row takes every tap (a tap on the switch would reach the row too on the web): the switch shows the state.
    toggle(switchOnly, { checked: () => on(), label: label }),
  )

export fn formsScreen(): View {
  return div(page, div(column, div(formBox,
    p(title2, "Create an account"),
    div(fieldWrap, p(fieldLabel, "NAME"), input(() => fieldStyle(nameBad()), { placeholder: "Your name", value: () => fName, onInput: (v) => { fName = v; update() } }), when(() => nameBad(), () => p(error, "Enter your name."))),
    div(fieldWrap, p(fieldLabel, "EMAIL"), input(() => fieldStyle(emailBad()), { placeholder: "you@example.com", inputType: "email", value: () => fEmail, onInput: (v) => { fEmail = v; update() } }), when(() => emailBad(), () => p(error, "Enter a valid email."))),
    div(fieldWrap, p(fieldLabel, "PASSWORD"), input(() => fieldStyle(passBad()), { placeholder: "At least 8 characters", inputType: "password", value: () => fPass, onInput: (v) => { fPass = v; update() } }),
      div(css({ flexDirection: "row", gap: 4 }), list(() => [0, 1, 2, 3], (i, k) => div(() => css({ flex: 1, height: 4, borderRadius: 2, backgroundColor: fPass.length > i * 3 + 2 ? (fPass.length >= 12 ? t().success : t().warning) : t().line })))),
      when(() => passBad(), () => p(error, "Use at least 8 characters.")),
    ),
    div(fieldWrap, p(fieldLabel, "PLAN"), segmented(["Free", "Plus", "Pro"], () => fPlan, (i) => { fPlan = i })),
    div(fieldWrap, p(fieldLabel, "T-SHIRT SIZE"), div(css({ flexDirection: "row", gap: space.sm, flexWrap: "wrap" }), list(() => ["XS", "S", "M", "L", "XL"], (s, i) => chip(s, () => fSize == i, () => { fSize = i })))),
    div(fieldWrap, p(fieldLabel, "ABOUT YOU"), textarea(areaStyle, { placeholder: "Optional", value: () => fAbout, onInput: (v) => { fAbout = v; update() } }), p(caption, () => `${fAbout.length}/200`)),
    switchRow("Send me the newsletter", () => fNews, (v) => { fNews = v }),
    switchRow("I accept the terms", () => fTerms, (v) => { fTerms = v }),
    primaryButton("Create account", () => submitForm()),
  )))
}

// ---- the welcome tour (a modal pager) ------------------------------------------------------------------------

let tourAt = 0
let tourDx = 0.0
let tourDragging = false

type TourPage = { glyph: string, title: string, text: string, photo: int }

const tour: TourPage[] = [
  { glyph: "◎", title: "Share what you see", text: "Post photos and stories, and keep the ones you love.", photo: 15 },
  { glyph: "✥", title: "Feels at home", text: "Each platform's own navigation, sheets, and gestures.", photo: 28 },
  { glyph: "▤", title: "Yours, on the device", text: "Likes, saves, notes, and settings stay in a local database.", photo: 42 },
  { glyph: "✦", title: "One script", text: "Written once in Nuclo Script, native on every device.", photo: 57 },
]

fn tourStrip() => css({ flexDirection: "row", width: pageW() * 4.0, translateX: 0.0 - toFloat(tourAt) * pageW() + tourDx, transition: tourDragging ? 0 : 420, easing: "spring" })
fn tourPage() => css({ width: pageW(), padding: space.xl, gap: space.lg, alignItems: "center" })
const tourImg = css({ width: 240, height: 240, borderRadius: 120, overflow: "hidden" })
const tourGlyph = themed(() => css({ fontSize: 34, color: t().accent }))
const tourText = themed(() => css({ fontSize: font.body, color: t().text2, textAlign: "center", lineHeight: 22, maxWidth: 300 }))
fn tourDot(i: int) => css({ width: i == tourAt ? 22 : 8, height: 8, borderRadius: 4, backgroundColor: i == tourAt ? t().accent : t().line, transition: 260, easing: "spring" })

export fn onboardingScreen(): View {
  tourAt = 0
  return div(page,
    div(css({ overflow: "hidden", pt: space.lg }),
      div(() => tourStrip(),
        {
          onPan: (e: Pan) => {
            tourDragging = e.state == "start" || e.state == "move"
            tourDx = e.dx
            if (!tourDragging) {
              tourDx = 0.0
              if ((e.dx < -60.0 || e.vx < -500.0) && tourAt < 3) { tourAt += 1; haptic("light") }
              if ((e.dx > 60.0 || e.vx > 500.0) && tourAt > 0) { tourAt -= 1; haptic("light") }
            }
            update()
          },
        },
        list(() => tour, (pg, i) => div(() => tourPage(), div(tourImg, img(fill, { src: photoUrl(pg.photo, 240) })), span(tourGlyph, pg.glyph), p(title1, pg.title), p(tourText, pg.text))),
      ),
    ),
    div(dotsRow, list(() => [0, 1, 2, 3], (i, k) => div(() => tourDot(i), { onClick: () => { tourAt = i; update() } }))),
    div(padded,
      btn(() => "filled", () => tourAt == 3 ? "Get started" : "Next", () => { if (tourAt < 3) { tourAt += 1; update() } else { back() } }),
      when(() => tourAt < 3, () => button(css({ color: t().muted, fontSize: font.sub, padding: space.sm }), "Skip", { onClick: () => back() })),
    ),
  )
}
