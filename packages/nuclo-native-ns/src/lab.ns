}

fn densityMenu(at: Point) {
  menuAt(at, "Density", [
    checked("Compact", density == "Compact", () => { density = "Compact" }),
    checked("Comfortable", density == "Comfortable", () => { density = "Comfortable" }),
    checked("Spacious", density == "Spacious", () => { density = "Spacious" }),
  ])
}

fn fontMenu(at: Point) {
  menuAt(at, "Font", [
    checked("System", fontPick == "System", () => { fontPick = "System" }),
    checked("Serif", fontPick == "Serif", () => { fontPick = "Serif" }),
    checked("Monospace", fontPick == "Monospace", () => { fontPick = "Monospace" }),
  ])
}

fn fileMenu(at: Point) {
  menuAt(at, "", [
    act("New", "＋", () => toast("New file")),
    act("Duplicate", "⧉", () => toast("Duplicated")),
    submenu("Share", "➤", () => menuAt(at, "Share", [act("Messages", "✉", () => toast("Shared to Messages")), act("Mail", "@", () => toast("Shared by mail")), submenu("More apps", "⋯", () => menuAt(at, "More apps", [act("Notes", "✎", () => toast("Saved to Notes")), act("Files", "▤", () => toast("Saved to Files"))]))])),
    submenu("Export as", "⇪", () => menuAt(at, "Export as", [act("PDF", "", () => toast("Exported as PDF")), act("PNG", "", () => toast("Exported as PNG")), act("Markdown", "", () => toast("Exported as Markdown"))])),
    destructive("Delete", "✕", () => alert("Delete file?", "This cannot be undone.", [{ label: "Cancel", glyph: "", kind: "cancel", run: () => {} }, destructive("Delete", "", () => toast("Deleted"))])),
  ])
}

export fn menusScreen(): View {
  return div(groupedPage, div(column,
    p(intro, "Popover menus with check marks and submenus, an action sheet, and a context menu. Each one remembers its choice."),
    div(menuGrid,
      div(menuBtn, span(grow, () => `Sort: ${sortBy}`), span(footnote, "⌄"), { onPointerDown: (pt: Point) => notePress(pt), onClick: () => sortMenu(pressedAt()) }),
      div(menuBtn, span(grow, () => `View: ${density} · ${fontPick}`), span(footnote, "⌄"), { onPointerDown: (pt: Point) => notePress(pt), onClick: () => viewMenu(pressedAt()) }),
      div(menuBtn, span(grow, "File menu with nested submenus"), span(footnote, "⋯"), { onPointerDown: (pt: Point) => notePress(pt), onClick: () => fileMenu(pressedAt()) }),
      div(menuBtn, span(grow, "Action sheet"), span(footnote, "↑"), { onClick: () => actionSheet("Photo", [
        act("Take photo", "◉", () => toast("Camera")), act("Choose from library", "▦", () => toast("Library")),
        act("Browse files", "▤", () => toast("Files")), destructive("Remove current photo", "", () => toast("Removed")),
      ]) }),
      div(css({ height: 120, borderRadius: radius.lg, alignItems: "center", justifyContent: "center", backgroundColor: t().accentSoft, pressed: { scale: 0.97 }, transition: 200, easing: "spring" }),
        { onLongPress: (pt: Point) => fileMenu(pt) },
        p(accentText, "Long press here for a context menu"),
      ),
    ),
    section("Current choices", [
      navCell("", "", "Sort", () => sortBy, () => {}),
      navCell("", "", "Show read", () => showRead ? "Yes" : "No", () => {}),
      navCell("", "", "Only flagged", () => showFlagged ? "Yes" : "No", () => {}),
      navCell("", "", "Density", () => density, () => {}),
    ]),
  ))
}

// ---- bottom sheets -------------------------------------------------------------------------------------------

let priceMax = 0.6
let kinds: Set<string> = Set(["Photos"])

fn filterContent(): View {
  const all: string[] = ["Photos", "Videos", "People", "Places", "Tags"]
  return div(padded,
    p(headline, "Show"),
    div(css({ flexDirection: "row", flexWrap: "wrap", gap: space.sm }), list(() => all, (k, i) => chip(k, () => kinds.has(k), () => { if (kinds.has(k)) { kinds.delete(k) } else { kinds.add(k) } }))),
    p(headline, "Distance"),
    slider("Within", t().accent, () => priceMax, (v) => { priceMax = v }),
    switchCell("", "", "Only people I follow", () => showFlagged, (v) => { showFlagged = v }),
    primaryButton("Apply", () => { closeSheet(); toast("Filters applied") }),
  )
}

fn shareContent(): View {
  return div(
    div(css({ flexDirection: "row", gap: space.lg, overflow: "scroll", padding: space.lg }), list(() => [2, 3, 4, 5, 6, 7, 8, 9], (n, i) => div(css({ alignItems: "center", gap: space.xs, width: 64, pressed: { scale: 0.92 } }), { onClick: () => toast(`Sent to ${user(`${n}`).name}`) }, avatar(user(`${n}`).avatar, 56), p(css({ fontSize: font.caption, color: t().text, numberOfLines: 1 }), user(`${n}`).name)))),
    div(divider),
    list(() => ["Copy link", "Add to story", "Share to…", "Save image"], (s, i) => div(css({ px: space.lg, py: space.md, pressed: { backgroundColor: t().surface2 } }), { onClick: () => toast(s) }, p(body, s))),
  )
}

fn longContent(): View {
  return div(list(() => users, (u, i) => div(css({ flexDirection: "row", alignItems: "center", gap: space.md, px: space.lg, py: space.sm }), avatar(u.avatar, 40), div(grow, p(strongText, u.name), p(footnote, u.bio)))))
}

fn nestedContent(): View {
  return div(padded,
    p(body, "A sheet can open another sheet over itself. Drag the grabber down to close it, or up to make it large."),
    secondaryButton("Open another sheet", () => sheet("Second sheet", "medium", () => div(padded, p(body, "This one is on top. Close it to get back to the first."), primaryButton("Open a third", () => sheet("Third sheet", "large", () => longContent()))))),
  )
