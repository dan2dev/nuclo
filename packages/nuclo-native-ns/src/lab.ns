/** A modal route: each platform presents it with its own sheet (UIKit, GTK, Android, the web). */
export fn nativeSheetScreen(): View {
  const inBar = barButton("Done", () => back())
  return div(page, div(padded,
    p(title2, "The platform's modal screen"),
    p(body, "This screen is a modal route, with its action in the bar: a full-screen dialog on Android, a page sheet on iOS, a libadwaita dialog on GTK (a bottom sheet in a narrow window), and a sheet you can drag down on the web."),
    when(() => !inBar, () => primaryButton("Done", () => back())),
  ))
}

