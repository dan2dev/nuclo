// The Lab tab: gestures (drag, swipe, pinch, long press, reorder, sliders, carousel, pull to refresh,
// swipe cards, drawing), menus, sheets, a collapsing header, forms, toasts, and the welcome tour. Each
// demo is a screen of its own, pushed on the Lab tab's stack.

import {
  css, div, p, span, button, img, input, textarea, toggle, list, when, update, go, back, later, haptic,
  viewport, View, StyleResult, Pan, Pinch, Point, Scroll, Action, barButton
} from "./ui"
import { t, space, radius, font, themed } from "./theme"
import { users, posts, user, photoUrl, photoUrlWH } from "./data"
import { setFlag } from "./state"
import {
  page, groupedPage, fixedPage, column, row, rowGap, rowBetween, grow, spacer, padded, gapSm, gapMd, card, title1,
  title2, title3, headline, body, sub, footnote, caption, strongText, accentText, avatar, section, navCell,
  switchCell, segmented, chip, toast, actionSheet, menuAt, sheet, closeSheet, nativeSlider, alert, act, destructive,
  checked, submenu, divider, btn, primaryButton, secondaryButton, dangerButton, smallButton, stepperField
} from "./kit"

fn abs(x: number): number => x < 0.0 ? 0.0 - x : x
fn clamp(x: number, lo: number, hi: number): number => x < lo ? lo : x > hi ? hi : x

const stage = themed(() => css({ flex: 1, backgroundColor: t().grouped, overflow: "hidden" }))
const intro = themed(() => css({ px: space.lg, pt: space.lg, pb: space.sm, fontSize: font.sub, color: t().text2, lineHeight: 20 }))
const readout = themed(() => css({ alignSelf: "center", px: space.md, py: space.xs, borderRadius: radius.pill, backgroundColor: t().surface, color: t().text2, fontSize: font.footnote, fontFamily: "monospace" }))

// ---- the index ----------------------------------------------------------------------------------

