// Line icons on a 24-unit grid, drawn by each platform at any size: an `img` whose src is an inline SVG.
// The web shows the SVG itself, Android and GPUI draw its path, GTK renders it with librsvg, and iOS shows
// the SF Symbol named in `data-icon`. One path per icon: absolute M, L, H, V, C, Q, and Z only.

import { css, img, list, View, StyleResult } from "./ui"

fn pathOf(name: string): string {
  if (name == "home") { return "M3.5 10.5 L12 3.5 L20.5 10.5 V20.5 H14.5 V14.5 H9.5 V20.5 H3.5 Z" }
  if (name == "search") { return "M17 10.5 C17 14.09 14.09 17 10.5 17 C6.91 17 4 14.09 4 10.5 C4 6.91 6.91 4 10.5 4 C14.09 4 17 6.91 17 10.5 Z M15.4 15.4 L20.5 20.5" }
  if (name == "grid") { return "M4 4 H10 V10 H4 Z M14 4 H20 V10 H14 Z M4 14 H10 V20 H4 Z M14 14 H20 V20 H14 Z" }
  if (name == "heart") { return "M12 20.5 C12 20.5 3 15 3 8.8 C3 6.1 5.1 4 7.7 4 C9.5 4 11.1 5 12 6.5 C12.9 5 14.5 4 16.3 4 C18.9 4 21 6.1 21 8.8 C21 15 12 20.5 12 20.5 Z" }
  if (name == "person") { return "M16 8 C16 10.21 14.21 12 12 12 C9.79 12 8 10.21 8 8 C8 5.79 9.79 4 12 4 C14.21 4 16 5.79 16 8 Z M4.5 20.5 C4.5 16.6 7.8 14.5 12 14.5 C16.2 14.5 19.5 16.6 19.5 20.5" }
  if (name == "comment") { return "M20.5 11.5 C20.5 16.2 16.7 20 12 20 C10.6 20 9.3 19.7 8.1 19.1 L3.5 20.5 L4.9 15.9 C4 14.6 3.5 13.1 3.5 11.5 C3.5 6.8 7.3 3 12 3 C16.7 3 20.5 6.8 20.5 11.5 Z" }
  if (name == "send") { return "M21 3 L10.5 13.5 M21 3 L14.5 21 L10.5 13.5 L3 9.5 Z" }
  if (name == "bookmark") { return "M6 3.5 H18 V21 L12 16.5 L6 21 Z" }
  if (name == "plus") { return "M12 5 V19 M5 12 H19" }
  if (name == "plusSquare") { return "M4 4 H20 V20 H4 Z M12 8 V16 M8 12 H16" }
  if (name == "menu") { return "M4 7 H20 M4 12 H20 M4 17 H20" }
  if (name == "mail") { return "M3.5 5.5 H20.5 V18.5 H3.5 Z M3.5 5.5 L12 12.5 L20.5 5.5" }
  if (name == "sliders") { return "M4 7 H14 M18 7 H20 M4 17 H6 M10 17 H20 M16 5 V9 M8 15 V19" }
  if (name == "close") { return "M6 6 L18 18 M18 6 L6 18" }
  if (name == "lock") { return "M5.5 11 H18.5 V20.5 H5.5 Z M8.5 11 V7.5 C8.5 5.57 10.07 4 12 4 C13.93 4 15.5 5.57 15.5 7.5 V11" }
  if (name == "bell") { return "M6 16.5 V11 C6 7.69 8.69 5 12 5 C15.31 5 18 7.69 18 11 V16.5 L19.5 18 H4.5 Z M10 20.5 C10.4 21.1 11.2 21.5 12 21.5 C12.8 21.5 13.6 21.1 14 20.5 M12 3 V5" }
  if (name == "pencil") { return "M4 20 L4.8 16.2 L15.5 5.5 C16.3 4.7 17.6 4.7 18.5 5.5 C19.3 6.4 19.3 7.7 18.5 8.5 L7.8 19.2 Z M14 7 L17 10" }
  if (name == "star") { return "M12 3.5 L14.6 9 L20.5 9.6 L16 13.6 L17.3 19.5 L12 16.5 L6.7 19.5 L8 13.6 L3.5 9.6 L9.4 9 Z" }
  if (name == "info") { return "M20.5 12 C20.5 16.69 16.69 20.5 12 20.5 C7.31 20.5 3.5 16.69 3.5 12 C3.5 7.31 7.31 3.5 12 3.5 C16.69 3.5 20.5 7.31 20.5 12 Z M12 11 V16.5 M12 7.8 V8" }
  if (name == "sparkle") { return "M12 3 C12.6 8.4 15.6 11.4 21 12 C15.6 12.6 12.6 15.6 12 21 C11.4 15.6 8.4 12.6 3 12 C8.4 11.4 11.4 8.4 12 3 Z" }
  if (name == "contrast") { return "M20.5 12 C20.5 16.69 16.69 20.5 12 20.5 C7.31 20.5 3.5 16.69 3.5 12 C3.5 7.31 7.31 3.5 12 3.5 C16.69 3.5 20.5 7.31 20.5 12 Z M12 3.5 V20.5 M12 7 H17.5 M12 11 H20 M12 15 H19.5" }
  if (name == "box") { return "M4 7.5 L12 3.5 L20 7.5 V16.5 L12 20.5 L4 16.5 Z M4 7.5 L12 11.5 L20 7.5 M12 11.5 V20.5" }
  if (name == "move") { return "M12 3 V21 M3 12 H21 M9 6 L12 3 L15 6 M9 18 L12 21 L15 18 M6 9 L3 12 L6 15 M18 9 L21 12 L18 15" }
  if (name == "swap") { return "M4 8 H19 M15.5 4.5 L19 8 L15.5 11.5 M20 16 H5 M8.5 12.5 L5 16 L8.5 19.5" }
  if (name == "expand") { return "M14 4 H20 V10 M20 4 L13.5 10.5 M10 20 H4 V14 M4 20 L10.5 13.5" }
  if (name == "target") { return "M20.5 12 C20.5 16.69 16.69 20.5 12 20.5 C7.31 20.5 3.5 16.69 3.5 12 C3.5 7.31 7.31 3.5 12 3.5 C16.69 3.5 20.5 7.31 20.5 12 Z M15 12 C15 13.66 13.66 15 12 15 C10.34 15 9 13.66 9 12 C9 10.34 10.34 9 12 9 C13.66 9 15 10.34 15 12 Z" }
  if (name == "carousel") { return "M7 5 H17 V19 H7 Z M3.5 7 V17 M20.5 7 V17" }
  if (name == "arrowBack") { return "M20 12 H4.5 M10.5 6 L4.5 12 L10.5 18" }
  if (name == "arrowDown") { return "M12 4 V19.5 M6 13.5 L12 19.5 L18 13.5" }
  if (name == "checkbox") { return "M4 4 H20 V20 H4 Z M8 12 L11 15 L16.5 9" }
  if (name == "sheet") { return "M4 4 H20 V20 H4 Z M4 13 H20 M10 16.5 H14" }
  if (name == "window") { return "M4 5 H20 V19 H4 Z M4 9 H20" }
  if (name == "header") { return "M4 4 H20 V10 H4 Z M4 14 H20 M4 18 H14" }
  if (name == "more") { return "M5.5 12 H6 M11.75 12 H12.25 M18 12 H18.5" }
  return "M12 9 C13.66 9 15 10.34 15 12 C15 13.66 13.66 15 12 15 C10.34 15 9 13.66 9 12 C9 10.34 10.34 9 12 9 Z"
}

/** Whether `name` is one of the icons (a cell's glyph may be an icon or a character). */
export fn isIcon(name: string): bool => name.length > 1 && pathOf(name) != pathOf("")

/** An icon as an inline SVG: a line in `color`, filled too when `filled`. `color` is #rrggbb. */
export fn iconSrc(name: string, color: string, filled: bool): string {
  const fill = filled ? color : "none"
  const width = name == "more" ? "3" : "1.8"
  return `data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='96' height='96' viewBox='0 0 24 24' data-icon='${name}${filled ? "Fill" : ""}' fill='${fill}' stroke='${color}' stroke-width='${width}' stroke-linecap='round' stroke-linejoin='round'><path d='${pathOf(name)}'/></svg>`
}

fn sized(size: number) => css({ width: size, height: size, pointerEvents: "none" })
const s16 = sized(16)
const s18 = sized(18)
const s20 = sized(20)
const s22 = sized(22)
const s24 = sized(24)
const s26 = sized(26)
const s28 = sized(28)

fn sizeStyle(size: int): StyleResult {
  if (size <= 16) { return s16 }
  if (size <= 18) { return s18 }
  if (size <= 20) { return s20 }
  if (size <= 22) { return s22 }
  if (size <= 24) { return s24 }
  if (size <= 26) { return s26 }
  return s28
}

/** A fixed icon. */
export fn icon(name: string, color: string, size: int): View => img(sizeStyle(size), { src: iconSrc(name, color, false) })

/** An icon whose colour or fill changes (a like, a save): rebuilt when they do. */
export fn liveIcon(name: string, color: () => string, filled: () => bool, size: int): View =>
  list(() => [iconSrc(name, color(), filled())], (src, i) => img(sizeStyle(size), { src: src }))
