// The component kit: text styles, buttons, cells, avatars, chips, a segmented control, and the overlay
// layer (toasts, action sheets, popover menus with submenus, bottom sheets with detents, alerts). Every
// screen is made of these, so the app looks the same on each platform.

import {
  css, div, p, span, button, img, toggle, group, list, when, update, later, haptic, viewport, Mod, View,
  StyleResult, Pan, Point, Look,
} from "./ui"
import { t, space, radius, font, themed } from "./theme"

// ---- text -----------------------------------------------------------------------------

export const largeTitle = themed(() => css({ fontSize: font.large, fontWeight: "bold", color: t().text, letterSpacing: -0.6 }))
export const title1 = themed(() => css({ fontSize: font.title1, fontWeight: "bold", color: t().text, letterSpacing: -0.4 }))
export const title2 = themed(() => css({ fontSize: font.title2, fontWeight: "bold", color: t().text, letterSpacing: -0.3 }))
export const title3 = themed(() => css({ fontSize: font.title3, fontWeight: "semibold", color: t().text }))
export const headline = themed(() => css({ fontSize: font.headline, fontWeight: "semibold", color: t().text }))
export const body = themed(() => css({ fontSize: font.body, color: t().text, lineHeight: 22 }))
export const sub = themed(() => css({ fontSize: font.sub, color: t().text2, lineHeight: 20 }))
export const footnote = themed(() => css({ fontSize: font.footnote, color: t().muted }))
export const caption = themed(() => css({ fontSize: font.caption, color: t().muted }))
export const strongText = themed(() => css({ fontSize: font.sub, fontWeight: "semibold", color: t().text }))
export const accentText = themed(() => css({ fontSize: font.sub, fontWeight: "semibold", color: t().accent }))
export const sectionLabel = themed(() => css({ fontSize: font.footnote, fontWeight: "semibold", color: t().muted, textTransform: "uppercase", letterSpacing: 0.4, px: space.lg + space.xs, pt: space.xl, pb: space.sm }))
export const oneLine = css({ numberOfLines: 1 })
export const twoLines = css({ numberOfLines: 2 })

// ---- layout -----------------------------------------------------------------------------

/** A screen: fills the window and scrolls. */
export const page = themed(() => css({ flex: 1, backgroundColor: t().bg, overflow: "scroll" }))
/** A screen of grouped lists (settings). */
export const groupedPage = themed(() => css({ flex: 1, backgroundColor: t().grouped, overflow: "scroll" }))
/** A screen that does not scroll: it lays its parts out itself. */
export const fixedPage = themed(() => css({ flex: 1, backgroundColor: t().bg }))
/** The content column: readable on a wide window. */
export const column = css({ alignSelf: "center", widthPct: 100, maxWidth: 680, pb: space.xxl })
export const padded = css({ padding: space.lg, gap: space.md })
export const row = css({ flexDirection: "row", alignItems: "center" })
export const rowGap = css({ flexDirection: "row", alignItems: "center", gap: space.sm })
export const rowBetween = css({ flexDirection: "row", alignItems: "center", justifyContent: "space-between" })
export const grow = css({ flex: 1 })
export const center = css({ alignItems: "center", justifyContent: "center" })
export const spacer = css({ flex: 1 })
export const gapSm = css({ gap: space.sm })
export const gapMd = css({ gap: space.md })
export const gapLg = css({ gap: space.lg })

export const card = themed(() => css({ backgroundColor: t().surface, borderRadius: radius.lg, padding: space.lg, gap: space.md, borderWidth: 1, borderColor: t().line }))
export const divider = themed(() => css({ height: 1, backgroundColor: t().line }))
export const hairline = themed(() => css({ height: 1, backgroundColor: t().line, ml: space.lg }))

