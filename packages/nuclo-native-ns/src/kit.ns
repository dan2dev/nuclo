}))
export const dangerBtn = themed(() => css({
  height: 48, px: space.xl, borderRadius: radius.md, backgroundColor: t().dangerSoft, color: t().danger,
  fontSize: font.headline, fontWeight: "semibold", alignItems: "center", justifyContent: "center", pressed: { opacity: 0.7 },
}))
export const smallBtn = themed(() => css({
  height: 32, px: space.lg, py: 0, borderRadius: radius.pill, backgroundColor: t().accent, color: t().accentText,
  fontSize: font.footnote, fontWeight: "semibold", alignItems: "center", justifyContent: "center", pressed: { opacity: 0.7 },
}))
export const smallGhostBtn = themed(() => css({
  height: 32, px: space.lg, py: 0, borderRadius: radius.pill, backgroundColor: t().surface2, color: t().text,
  fontSize: font.footnote, fontWeight: "semibold", alignItems: "center", justifyContent: "center", pressed: { opacity: 0.7 },
}))
export const linkBtn = themed(() => css({ padding: space.sm, color: t().accent, fontSize: font.headline, pressed: pressedLook }))
export const iconBtn = themed(() => css({
  width: 40, height: 40, padding: 0, borderRadius: 20, alignItems: "center", justifyContent: "center",
  color: t().text, fontSize: 22, pressed: { opacity: 0.5, scale: 0.9 }, transition: 120, hover: { backgroundColor: t().surface2 },
}))
